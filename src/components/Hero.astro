---
/**
 * Hero.astro — первый экран.
 *
 * Перенос шаблона nexum-hero-v3 на Astro. Отличия от исходника:
 * форма подписки убрана (бэкенда нет), карточки заполнены настоящим
 * содержимым вместо вымышленного отзыва, добавлена кнопка фоновой музыки.
 */
import { getCollection } from 'astro:content';
import { SOCIALS } from '../consts';

const posts = (await getCollection('blog', (e) => e.data.lang === 'en' && !e.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = posts[0];
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const links = [
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];
---

<section class="hero">
  <video
    src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260803_192301_9231ed6b-c55c-4a48-909c-4ebe11cf2e11.mp4"
    autoplay loop muted playsinline preload="auto"
    poster="/hero-frame.jpg"
    aria-hidden="true"
  ></video>

  <div class="layer">
    <nav>
      <a class="brand" href="/">
        <svg width="24" height="24" viewBox="0 0 256 256" aria-hidden="true">
          <path d="M 128 128 C 128 198.692 70.692 256 0 256 C 0 185.308 57.308 128 128 128 Z M 128 128 C 198.692 128 256 185.308 256 256 C 185.308 256 128 198.692 128 128 Z M 128 128 C 128 57.308 185.308 0 256 0 C 256 70.692 198.692 128 128 128 Z M 128 128 C 57.308 128 0 70.692 0 0 C 70.692 0 128 57.308 128 128 Z" />
        </svg>
        <span>Khondamir</span>
      </a>

      <div class="nav-right">
        <div class="links">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      </div>

      <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false">
        <svg class="m" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
        <svg class="x" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
      </button>
    </nav>

    <div class="content">
      <div>
        <h1>Building AI products, and writing down what actually works</h1>
        <p class="sub">Khondamir Begmatov — from international relations to shipping products with AI.</p>
      </div>

      <div class="cards">
        {latest && (
          <a class="card stat-card" href={`/blog/${latest.data.transId}`}>
            <div class="stat">{fmt(latest.data.pubDate)}</div>
            <p><b>{latest.data.title}</b></p>
            <p class="quote">{latest.data.excerpt}</p>
          </a>
        )}
        <div class="card">
          <div class="mark"><i>K</i>About</div>
          <p class="quote">I build small AI products alone and write about what changes the work of a builder — no corporate fog.</p>
          <div class="who">
            <div>
              <b>Khondamir Begmatov</b>
              <small>Builder · {posts.length} posts</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="scrim" id="scrim"></div>
<aside class="drawer" id="drawer">
  <a href="/blog">Blog</a>
  <a href="/about">About</a>
  <span class="drawer__rule" aria-hidden="true"></span>
  {Object.entries(SOCIALS).filter(([k]) => k !== 'email').map(([k, href]) => (
    <a href={href} target="_blank" rel="noopener noreferrer">{k[0].toUpperCase() + k.slice(1)}</a>
  ))}
  <a class="cta" href="/blog">Read the blog</a>
</aside>

<script>
  /* View transitions swap the DOM without re-running scripts that already
     executed, and `autoplay` only fires when the document is first parsed.
     Coming back to the home page therefore left dead handlers and a frozen
     video. Everything below re-binds on every navigation instead. */
  function bindHero() {
    const burger = document.getElementById('burger');
    const scrim = document.getElementById('scrim');

    const close = () => {
      document.body.classList.remove('open');
      burger?.setAttribute('aria-expanded', 'false');
    };

    if (burger && !(burger as any)._bound) {
      (burger as any)._bound = true;
      burger.addEventListener('click', () => {
        const open = document.body.classList.toggle('open');
        burger.setAttribute('aria-expanded', String(open));
      });
    }
    if (scrim && !(scrim as any)._bound) {
      (scrim as any)._bound = true;
      scrim.addEventListener('click', close);
    }
    if (!(document as any)._heroEsc) {
      (document as any)._heroEsc = true;
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    }

    // Панель могла остаться открытой на момент ухода со страницы.
    document.body.classList.remove('open');

    /* Возврат на главную через мягкий переход даёт элемент <video>, вставленный
       уже после загрузки документа. Атрибут autoplay в этот момент не действует,
       а программный play() браузер отклоняет как воспроизведение без жеста
       пользователя — и кадр застывает. Пересоздание узла возвращает ему статус
       свежевставленного, а если политика всё равно откажет, включаем по первому
       касанию страницы. */
    const old = document.querySelector<HTMLVideoElement>('.hero video');
    if (old) {
      const video = old.cloneNode(true) as HTMLVideoElement;
      video.muted = true;
      video.defaultMuted = true;
      video.autoplay = true;
      video.playsInline = true;
      video.setAttribute('muted', '');
      video.setAttribute('playsinline', '');
      old.replaceWith(video);

      const start = () => {
        const p = video.play();
        if (p) p.catch(() => {});
      };
      start();
      video.addEventListener('loadeddata', start, { once: true });
      video.addEventListener('canplay', start, { once: true });

      // последний рубеж: политика автозапуска снимается любым жестом
      const onGesture = () => {
        if (video.paused) start();
        document.removeEventListener('pointerdown', onGesture);
        document.removeEventListener('touchstart', onGesture);
      };
      document.addEventListener('pointerdown', onGesture, { passive: true });
      document.addEventListener('touchstart', onGesture, { passive: true });
    }
  }

  bindHero();
  document.addEventListener('astro:page-load', bindHero);
  // вкладку свернули и вернули — видео тоже могло встать
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) bindHero();
  });
</script>
