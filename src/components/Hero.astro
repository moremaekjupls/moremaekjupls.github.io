---
import '../styles/hero.css';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const COPY = {
  en: { name: ['Khondamir', 'Begmatov'], lede: 'AI products, and the notes of someone building them. The tools keep changing — the thinking is the work.', cta: 'Read the notes' },
  ru: { name: ['Хондамир', 'Бегматов'], lede: 'ИИ-продукты и заметки того, кто их собирает. Инструменты меняются — мышление остаётся работой.', cta: 'Читать заметки' },
} as const;
const t = COPY[lang];
const blogHref = lang === 'en' ? '/en/blog' : '/blog';
---

<section class="hero" data-hero data-live-library aria-label={t.name.join(' ')}>
  <div class="hero__library" aria-hidden="true"></div>
  <div class="hero__book-depth hero__book-depth--left" aria-hidden="true"></div>
  <div class="hero__book-depth hero__book-depth--right" aria-hidden="true"></div>
  <div class="hero__rings" aria-hidden="true">
    <span class="hero__ring hero__ring--one"></span>
    <span class="hero__ring hero__ring--two"></span>
    <span class="hero__ring hero__ring--three"></span>
  </div>
  <canvas class="hero__canvas" aria-hidden="true"></canvas>
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__grain" aria-hidden="true"></div>
  <div class="hero__vignette" aria-hidden="true"></div>

  <div class="hero__content">
    <h1 class="hero__name">{t.name[0]}<br />{t.name[1]}</h1>
    <div class="hero__aside">
      <p class="hero__lede">{t.lede}</p>
      <a class="hero__cta" href={blogHref}>
        <span>{t.cta}</span>
        <svg viewBox="0 0 28 8" width="28" height="8" aria-hidden="true"><path d="M0 4h25M22 1l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1" /></svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { createHeroScene } from '../scripts/heroScene';

  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((section) => {
    const canvas = section.querySelector<HTMLCanvasElement>('.hero__canvas');
    if (!canvas) return;

    try {
      const scene = createHeroScene({ canvas, modelUrl: '/models/mage.glb' });
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        section.addEventListener('pointermove', (event) => {
          const rect = section.getBoundingClientRect();
          const x = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
          const y = ((event.clientY - rect.top) / rect.height - 0.5) * 2;
          section.style.setProperty('--parallax-x', `${x * 10}px`);
          section.style.setProperty('--parallax-y', `${y * 8}px`);
        }, { passive: true });
        section.addEventListener('pointerleave', () => {
          section.style.setProperty('--parallax-x', '0px');
          section.style.setProperty('--parallax-y', '0px');
        }, { passive: true });
      }
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => scene.setPaused(!entry.isIntersecting), { threshold: 0.05 }).observe(section);
      }
    } catch {
      canvas.remove();
    }
  });
</script>
