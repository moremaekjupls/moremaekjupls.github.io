---
/**
 * Hero.astro — первый экран.
 *
 * Полноэкранное видео, заголовок и две карточки (свежий пост и цитата).
 * На телефоне карточек нет — свежий пост вынесен в выдвижное меню.
 */
import { SOCIALS } from '../consts';
import SoundToggle from './SoundToggle.astro';
import { getPosts, postUrl, formatDate } from '../lib/site';

const [latest] = await getPosts();
const fmt = (d: Date) => formatDate(d, 'short');

const socials = Object.entries(SOCIALS).filter(([k]) => k !== 'email');
const LABELS: Record<string, string> = { github: 'GitHub', x: 'X', linkedin: 'LinkedIn' };

const links = [
  { href: '/blog/', label: 'Blog' },
  { href: '/history/', label: 'History' },
  { href: '/about/', label: 'About' },
];
---

<section class="hero">
  <video autoplay loop muted playsinline preload="auto" poster="/hero-frame.jpg" aria-hidden="true">
    <source src="/hero.mp4" type="video/mp4" />
  </video>
  <!-- Тон кадра по времени суток: слой смешивается с видео через mix-blend-mode. -->
  <div class="hero__tint" aria-hidden="true"></div>

  <div class="layer">
    <nav>
      <a class="brand" href="/" aria-current="page">
        <svg width="24" height="24" viewBox="0 0 256 256" aria-hidden="true">
          <path d="M 128 128 C 128 198.692 70.692 256 0 256 C 0 185.308 57.308 128 128 128 Z M 128 128 C 198.692 128 256 185.308 256 256 C 185.308 256 128 198.692 128 128 Z M 128 128 C 128 57.308 185.308 0 256 0 C 256 70.692 198.692 128 128 128 Z M 128 128 C 57.308 128 0 70.692 0 0 C 70.692 0 128 57.308 128 128 Z" />
        </svg>
        <span>Khondamir</span>
      </a>

      <div class="nav-right">
        <div class="links" role="navigation" aria-label="Main">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      </div>

      <button class="burger" id="burger" type="button" data-sound-skip aria-label="Open menu" aria-expanded="false" aria-controls="drawer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><line class="l1" x1="4" y1="6" x2="20" y2="6" /><line class="l2" x1="4" y1="12" x2="20" y2="12" /><line class="l3" x1="4" y1="18" x2="20" y2="18" /></svg>
      </button>
    </nav>

    <div class="content">
      <div>
        <p class="hero__time" data-clock hidden></p>
        <h1>Building products, and writing down what actually works</h1>
      </div>

      <div class="cards">
        {latest && (
          <a class="card stat-card" href={postUrl(latest)}>
            <div class="stat">{fmt(latest.data.pubDate)}</div>
            <p style={`view-transition-name:post-${latest.data.transId}`}><b>{latest.data.title}</b></p>
            <p class="quote">{latest.data.excerpt}</p>
          </a>
        )}
        <div class="card quote-card">
          <p class="quote">“I did not conquer half the world by listening to men who had conquered nothing.”</p>
          <div class="who">
            <div>
              <b>Alexander the Great</b>
              <small>attributed</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="scrim" id="scrim" aria-hidden="true"></div>
<aside class="drawer" id="drawer" aria-label="Menu" inert>
  <a href="/blog/">Blog</a>
  <a href="/history/">History</a>
  <a href="/about/">About</a>
  {latest && (
    <a class="drawer__latest" href={postUrl(latest)}>
      <small>Latest · {fmt(latest.data.pubDate)}</small>
      <span>{latest.data.title}</span>
    </a>
  )}
  <span class="drawer__rule" aria-hidden="true"></span>
  {socials.map(([k, href]) => (
    <a class="drawer__social" href={href} target="_blank" rel="noopener noreferrer">{LABELS[k] ?? k}</a>
  ))}
  <a class="drawer__social" href={SOCIALS.email}>Email</a>
  <SoundToggle class="drawer__sound" />
</aside>

<script>
  import { play as sound, haptic } from '../lib/sound';
  const burger = document.getElementById('burger');
  const drawer = document.getElementById('drawer');
  const scrim = document.getElementById('scrim');

  const hero = document.querySelector<HTMLElement>('.hero video'); // фон, который отодвигается
  let inertTimer = 0;

  function setOpen(open: boolean, focus = true) {
    if (!burger || !drawer) return;
    document.body.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    // inert убирает закрытую панель из Tab-порядка и от скринридеров. Ставим
    // его после того, как панель уехала: inert блокирует и указатель, а
    // уезжающую панель должно быть можно поймать пальцем.
    clearTimeout(inertTimer);
    if (open) drawer.removeAttribute('inert');
    else inertTimer = window.setTimeout(() => drawer.setAttribute('inert', ''), 340);
    // Фокус внутрь — для клавиатуры и скринридеров; кольцо фокуса браузер
    // покажет только при навигации с клавиатуры (:focus-visible).
    if (open && focus) drawer.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
  }

  burger?.addEventListener('click', (e) => {
    const open = !document.body.classList.contains('open');
    setOpen(open);
    if (e.detail > 0) sound(open ? 'open' : 'close');   // detail 0 — нажато с клавиатуры
  });
  scrim?.addEventListener('click', () => { setOpen(false); sound('close'); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.body.classList.contains('open')) { setOpen(false); burger?.focus(); }
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', () => setOpen(false));
  // Возврат по «Назад» из bfcache: панель не должна остаться открытой.
  window.addEventListener('pageshow', (e) => { if (e.persisted) setOpen(false); });

  /* Свайп вправо закрывает панель — как лист в iOS.
     · Панель едет за пальцем 1:1, с учётом точки захвата.
     · Её можно поймать на лету — пока открывается или уже уезжает: жест
       стартует с того места, где панель сейчас на экране, а не с конечной
       точки анимации, поэтому скачка нет.
     · Потянуть влево можно, но с нарастающим сопротивлением (rubber-band).
     · Решение по отпусканию — по прогнозу, куда долетит жест с текущей
       скоростью: короткий резкий флик закрывает, медленное дотягивание до
       середины — возвращает.
     · Длительность финиша подобрана под скорость пальца — на стыке нет рывка.
     · Фон (видео) отодвигается вглубь пропорционально тому, насколько
       открыта панель. */
  if (drawer && scrim) {
    const INTENT = 10;               // px до того, как решаем, чей это жест
    const DECEL = 0.998;             // замедление, как у прокрутки iOS
    const PUSH = 0.04;               // насколько уменьшается фон при открытой панели
    const project = (v: number) => (v * DECEL) / (1 - DECEL); // v в px/мс → px
    const rubber = (d: number, dim: number, c = 0.55) => (d * dim * c) / (dim + c * Math.abs(d));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    let id: number | null = null;
    let x0 = 0, y0 = 0, dx = 0, base = 0, pos = 0, width = 0;
    let state: 'idle' | 'pending' | 'drag' | 'scroll' = 'idle';
    let frozen = false;
    let samples: { x: number; t: number }[] = [];
    let suppressClick = false;

    // Где панель сейчас на экране — с учётом идущей анимации.
    const liveX = () => new DOMMatrixReadOnly(getComputedStyle(drawer).transform).m41;

    const paint = (x: number) => {
      pos = x;
      const offset = x >= 0 ? x : rubber(x, width);
      const progress = 1 - Math.min(1, Math.max(0, x) / width); // 1 — открыта
      drawer.style.transform = `translateX(${offset}px)`;
      scrim.style.opacity = String(progress);
      if (hero && !reduce.matches) {
        hero.style.transform = `scale(${1 - PUSH * progress})`;
        hero.style.borderRadius = `${18 * progress}px`;
      }
    };

    const grab = () => {
      frozen = true;
      drawer.classList.add('is-dragging');
      scrim.classList.add('is-dragging');
      hero?.classList.add('is-dragging');
      paint(base);
    };

    drawer.addEventListener('pointerdown', (e) => {
      if (id !== null || e.button > 0) return;              // второй палец игнорируем
      width = drawer.getBoundingClientRect().width;
      base = liveX();
      const moving = base > 0.5 && base < width - 0.5;
      if (!document.body.classList.contains('open') && !moving) return;
      id = e.pointerId; x0 = e.clientX; y0 = e.clientY; dx = 0;
      samples = [{ x: e.clientX, t: e.timeStamp }];
      state = 'pending'; frozen = false;
      if (moving) {                                         // поймали на лету
        grab();
        drawer.setPointerCapture(e.pointerId);
        if (!document.body.classList.contains('open')) setOpen(true, false);
      }
    });

    drawer.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id || state === 'idle' || state === 'scroll') return;
      const mx = e.clientX - x0, my = e.clientY - y0;
      if (state === 'pending') {
        if (Math.hypot(mx, my) < INTENT) return;
        // Вертикальное намерение у открытой панели — это её прокрутка.
        if (!frozen && Math.abs(my) > Math.abs(mx)) { state = 'scroll'; return; }
        state = 'drag';
        x0 = e.clientX;              // старт с этой точки — без скачка на величину порога
        if (!frozen) { drawer.setPointerCapture(e.pointerId); grab(); }
      }
      dx = e.clientX - x0;
      samples.push({ x: e.clientX, t: e.timeStamp });
      if (samples.length > 6) samples.shift();
      paint(base + dx);
    });

    const release = (e: PointerEvent) => {
      if (e.pointerId !== id) return;
      const dragged = state === 'drag';
      id = null; state = 'idle';
      if (!frozen) return;           // обычный тап по ссылке — пусть работает
      frozen = false;
      suppressClick = true;          // палец отпустили над ссылкой — это не клик

      const first = samples[0], last = samples[samples.length - 1];
      const dt = Math.max(1, last.t - first.t);
      const v = !dragged || e.type === 'pointercancel' ? 0 : (last.x - first.x) / dt; // px/мс, > 0 — вправо
      const close = pos + project(v) > width / 2;

      // Остаток пути делим на скорость пальца: быстрый флик — быстрый финиш.
      const remaining = close ? width - Math.max(pos, 0) : Math.abs(pos);
      const ms = Math.abs(v) > 0.05 ? Math.min(420, Math.max(180, remaining / Math.abs(v))) : 320;
      const curve = `${ms}ms var(--ease-drawer)`;
      for (const el of [drawer, scrim, hero]) el?.classList.remove('is-dragging');
      drawer.style.transition = `transform ${curve}, visibility 0s ${close ? ms : 0}ms`;
      scrim.style.transition = `opacity ${curve}`;
      if (hero) hero.style.transition = `transform ${curve}, border-radius ${curve}`;
      for (const el of [drawer, hero]) { if (el) { el.style.transform = ''; } }
      if (hero) hero.style.borderRadius = '';
      scrim.style.opacity = '';
      setOpen(!close, false);
      if (close) { sound('close'); haptic(); }
      window.setTimeout(() => {
        for (const el of [drawer, scrim, hero]) if (el) el.style.transition = '';
      }, ms + 20);
    };
    // Тянуть панель, взявшись за ссылку, — нормальный жест. Без этого браузер
    // начинает перетаскивать саму ссылку и отменяет наш жест (pointercancel).
    drawer.addEventListener('dragstart', (e) => e.preventDefault());
    drawer.addEventListener('pointerup', release);
    drawer.addEventListener('pointercancel', release);
    drawer.addEventListener('click', (e) => {
      if (suppressClick) { e.preventDefault(); e.stopPropagation(); suppressClick = false; }
    }, true);
    drawer.addEventListener('pointerdown', () => { suppressClick = false; }, true);
  }

  /* Время суток. Кадр один и тот же, меняется его тон: рассвет розовеет,
     золотой час теплеет, ночью картинка уходит в холодный синий. Время —
     локальное, с устройства. Для проверки: ?hour=23 */
  if (hero) {
    const clock = document.querySelector<HTMLElement>('[data-clock]');
    const forced = new URLSearchParams(location.search).get('hour');
    const PERIODS: [number, string, string][] = [
      [0, 'night', 'Night'], [5, 'dawn', 'Dawn'], [8, 'day', 'Morning'], [12, 'day', 'Afternoon'],
      [17, 'evening', 'Golden hour'], [20, 'dusk', 'Dusk'], [22, 'night', 'Night'],
    ];
    const now = () => {
      const d = new Date();
      if (forced !== null && !Number.isNaN(+forced)) d.setHours(+forced % 24, 0);
      return d;
    };
    const periodAt = (h: number) => PERIODS.filter(([start]) => h >= start).at(-1)!;

    const root = document.documentElement;
    const tick = () => {
      const d = now();
      const [, id, label] = periodAt(d.getHours());
      // Начальный период уже поставлен скриптом в <head>. Здесь — только смена
      // периода, пока страница открыта: цветной слой уходит, фильтр видео
      // плавно перетекает, слой возвращается.
      if (root.dataset.period !== id) {
        root.classList.add('is-retinting');
        root.dataset.period = id;
        window.setTimeout(() => root.classList.remove('is-retinting'), 1600);
      }
      if (clock) {
        clock.textContent = `${label} · ${d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
        clock.hidden = false;
      }
    };
    tick();
    // Следующий тик — ровно на смене минуты, дальше раз в минуту.
    window.setTimeout(() => { tick(); window.setInterval(tick, 60_000); }, 60_000 - (Date.now() % 60_000));
    document.addEventListener('visibilitychange', () => { if (!document.hidden) tick(); });
  }

  /* Автозапуск видео. iOS в режиме энергосбережения и некоторые Android-браузеры
     блокируют autoplay — тогда запускаем по первому касанию. При возврате на
     вкладку браузер ставит ролик на паузу — продолжаем. */
  const video = document.querySelector<HTMLVideoElement>('.hero video');
  const play = () => { if (video && video.paused) video.play()?.catch(() => {}); };
  if (video) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduce.matches) { video.removeAttribute('autoplay'); video.pause(); }
    else {
      play();
      document.addEventListener('pointerdown', play, { once: true, passive: true });
      document.addEventListener('visibilitychange', () => { if (!document.hidden) play(); });
    }
  }
</script>
