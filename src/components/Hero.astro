---
/**
 * Hero.astro — первый экран.
 *
 * Полноэкранное видео, заголовок и две карточки (свежий пост и цитата).
 * На телефоне карточек нет — свежий пост вынесен в выдвижное меню.
 */
import { getCollection } from 'astro:content';
import { SOCIALS } from '../consts';

const posts = (await getCollection('blog', (e) => e.data.lang === 'en' && !e.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = posts[0];
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const socials = Object.entries(SOCIALS).filter(([k]) => k !== 'email');
const LABELS: Record<string, string> = { github: 'GitHub', x: 'X', linkedin: 'LinkedIn' };

const links = [
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
];
---

<section class="hero">
  <video autoplay loop muted playsinline preload="auto" poster="/hero-frame.jpg" aria-hidden="true">
    <source src="/hero.mp4" type="video/mp4" />
  </video>

  <div class="layer">
    <nav>
      <a class="brand" href="/" aria-current="page">
        <svg width="24" height="24" viewBox="0 0 256 256" aria-hidden="true">
          <path d="M 128 128 C 128 198.692 70.692 256 0 256 C 0 185.308 57.308 128 128 128 Z M 128 128 C 198.692 128 256 185.308 256 256 C 185.308 256 128 198.692 128 128 Z M 128 128 C 128 57.308 185.308 0 256 0 C 256 70.692 198.692 128 128 128 Z M 128 128 C 57.308 128 0 70.692 0 0 C 70.692 0 128 57.308 128 128 Z" />
        </svg>
        <span>Khondamir</span>
      </a>

      <div class="nav-right">
        <div class="links" role="navigation" aria-label="Main">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      </div>

      <button class="burger" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="drawer">
        <svg class="m" viewBox="0 0 24 24" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
        <svg class="x" viewBox="0 0 24 24" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
      </button>
    </nav>

    <div class="content">
      <div>
        <h1>Building products, and writing down what actually works</h1>
      </div>

      <div class="cards">
        {latest && (
          <a class="card stat-card" href={`/blog/${latest.data.transId}/`}>
            <div class="stat">{fmt(latest.data.pubDate)}</div>
            <p><b>{latest.data.title}</b></p>
            <p class="quote">{latest.data.excerpt}</p>
          </a>
        )}
        <div class="card quote-card">
          <p class="quote">“I did not conquer half the world by listening to men who had conquered nothing.”</p>
          <div class="who">
            <div>
              <b>Alexander the Great</b>
              <small>attributed</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="scrim" id="scrim" aria-hidden="true"></div>
<aside class="drawer" id="drawer" aria-label="Menu" inert>
  <a href="/blog/">Blog</a>
  <a href="/about/">About</a>
  {latest && (
    <a class="drawer__latest" href={`/blog/${latest.data.transId}/`}>
      <small>Latest · {fmt(latest.data.pubDate)}</small>
      <span>{latest.data.title}</span>
    </a>
  )}
  <span class="drawer__rule" aria-hidden="true"></span>
  {socials.map(([k, href]) => (
    <a class="drawer__social" href={href} target="_blank" rel="noopener noreferrer">{LABELS[k] ?? k}</a>
  ))}
  <a class="drawer__social" href={SOCIALS.email}>Email</a>
</aside>

<script>
  const burger = document.getElementById('burger');
  const drawer = document.getElementById('drawer');
  const scrim = document.getElementById('scrim');

  function setOpen(open: boolean) {
    if (!burger || !drawer) return;
    document.body.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    // inert убирает закрытую панель из Tab-порядка и от скринридеров:
    // без него фокус с клавиатуры уходил в невидимые ссылки за краем экрана.
    drawer.toggleAttribute('inert', !open);
    // Фокус внутрь — для клавиатуры и скринридеров; кольцо фокуса браузер
    // покажет только при навигации с клавиатуры (:focus-visible).
    if (open) drawer.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
  }

  burger?.addEventListener('click', () => setOpen(!document.body.classList.contains('open')));
  scrim?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.body.classList.contains('open')) { setOpen(false); burger?.focus(); }
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', () => setOpen(false));
  // Возврат по «Назад» из bfcache: панель не должна остаться открытой.
  window.addEventListener('pageshow', (e) => { if (e.persisted) setOpen(false); });

  /* Свайп вправо закрывает панель — как лист в iOS.
     · Панель едет за пальцем 1:1, с учётом точки захвата.
     · Потянуть влево можно, но с нарастающим сопротивлением (rubber-band).
     · Решение по отпусканию — по прогнозу, куда долетит жест с текущей
       скоростью, а не по пройденному расстоянию: короткий резкий флик
       закрывает, медленное дотягивание до середины — возвращает.
     · Анимация после отпускания стартует с текущей позиции, а длительность
       подобрана под скорость пальца, чтобы на стыке не было рывка. */
  if (drawer && scrim) {
    const INTENT = 10;               // px до того, как решаем, чей это жест
    const DECEL = 0.998;             // замедление, как у прокрутки iOS
    const project = (v: number) => (v * DECEL) / (1 - DECEL); // v в px/мс → px
    const rubber = (d: number, dim: number, c = 0.55) => (d * dim * c) / (dim + c * Math.abs(d));

    let id: number | null = null;
    let x0 = 0, y0 = 0, dx = 0, width = 0;
    let state: 'idle' | 'pending' | 'drag' | 'scroll' = 'idle';
    let samples: { x: number; t: number }[] = [];
    let suppressClick = false;

    const apply = (x: number) => {
      const offset = x >= 0 ? x : rubber(x, width);
      drawer.style.transform = `translateX(${offset}px)`;
      scrim.style.opacity = String(Math.max(0, 1 - Math.max(0, x) / width));
    };

    drawer.addEventListener('pointerdown', (e) => {
      if (id !== null || !document.body.classList.contains('open') || e.button > 0) return; // второй палец игнорируем
      id = e.pointerId; x0 = e.clientX; y0 = e.clientY; dx = 0;
      width = drawer.getBoundingClientRect().width;
      samples = [{ x: e.clientX, t: e.timeStamp }];
      state = 'pending';
    });

    drawer.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id || state === 'idle' || state === 'scroll') return;
      const mx = e.clientX - x0, my = e.clientY - y0;
      if (state === 'pending') {
        if (Math.hypot(mx, my) < INTENT) return;
        // Вертикальное намерение — это прокрутка панели, не наш жест.
        if (Math.abs(my) > Math.abs(mx)) { state = 'scroll'; return; }
        state = 'drag';
        x0 = e.clientX;              // старт с этой точки — без скачка на величину порога
        drawer.setPointerCapture(e.pointerId);
        drawer.classList.add('is-dragging');
        scrim.classList.add('is-dragging');
      }
      dx = e.clientX - x0;
      samples.push({ x: e.clientX, t: e.timeStamp });
      if (samples.length > 6) samples.shift();
      apply(dx);
    });

    const release = (e: PointerEvent) => {
      if (e.pointerId !== id) return;
      const wasDrag = state === 'drag';
      id = null; state = 'idle';
      if (!wasDrag) return;
      suppressClick = true;          // палец отпустили над ссылкой — это не клик

      const first = samples[0], last = samples[samples.length - 1];
      const dt = Math.max(1, last.t - first.t);
      const v = e.type === 'pointercancel' ? 0 : (last.x - first.x) / dt; // px/мс, > 0 — вправо
      const close = dx + project(v) > width / 2 || v > 0.5;

      // Остаток пути делим на скорость пальца: быстрый флик — быстрый финиш.
      const remaining = close ? width - Math.max(dx, 0) : Math.abs(dx);
      const ms = Math.abs(v) > 0.05 ? Math.min(420, Math.max(180, remaining / Math.abs(v))) : 320;
      drawer.classList.remove('is-dragging');
      scrim.classList.remove('is-dragging');
      drawer.style.transition = `transform ${ms}ms var(--ease-drawer), visibility 0s ${close ? ms : 0}ms`;
      scrim.style.transition = `opacity ${ms}ms var(--ease-drawer)`;
      drawer.style.transform = '';
      scrim.style.opacity = '';
      if (close) setOpen(false);
      drawer.addEventListener('transitionend', () => {
        drawer.style.transition = '';
        scrim.style.transition = '';
      }, { once: true });
    };
    drawer.addEventListener('pointerup', release);
    drawer.addEventListener('pointercancel', release);
    drawer.addEventListener('click', (e) => {
      if (suppressClick) { e.preventDefault(); e.stopPropagation(); suppressClick = false; }
    }, true);
    drawer.addEventListener('pointerdown', () => { suppressClick = false; }, true);
  }

  /* Автозапуск видео. iOS в режиме энергосбережения и некоторые Android-браузеры
     блокируют autoplay — тогда запускаем по первому касанию. При возврате на
     вкладку браузер ставит ролик на паузу — продолжаем. */
  const video = document.querySelector<HTMLVideoElement>('.hero video');
  const play = () => { if (video && video.paused) video.play()?.catch(() => {}); };
  if (video) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduce.matches) { video.removeAttribute('autoplay'); video.pause(); }
    else {
      play();
      document.addEventListener('pointerdown', play, { once: true, passive: true });
      document.addEventListener('visibilitychange', () => { if (!document.hidden) play(); });
    }
  }
</script>
