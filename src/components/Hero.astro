---
/**
 * Hero.astro — первый экран.
 *
 * Полноэкранное видео, заголовок и две карточки (свежий пост и цитата).
 * На телефоне карточек нет — свежий пост вынесен в выдвижное меню.
 */
import { getCollection } from 'astro:content';
import { SOCIALS } from '../consts';

const posts = (await getCollection('blog', (e) => e.data.lang === 'en' && !e.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = posts[0];
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const socials = Object.entries(SOCIALS).filter(([k]) => k !== 'email');
const LABELS: Record<string, string> = { github: 'GitHub', x: 'X', linkedin: 'LinkedIn' };

const links = [
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
];
---

<section class="hero">
  <video autoplay loop muted playsinline preload="auto" poster="/hero-frame.jpg" aria-hidden="true">
    <source src="/hero.mp4" type="video/mp4" />
  </video>

  <div class="layer">
    <nav>
      <a class="brand" href="/" aria-current="page">
        <svg width="24" height="24" viewBox="0 0 256 256" aria-hidden="true">
          <path d="M 128 128 C 128 198.692 70.692 256 0 256 C 0 185.308 57.308 128 128 128 Z M 128 128 C 198.692 128 256 185.308 256 256 C 185.308 256 128 198.692 128 128 Z M 128 128 C 128 57.308 185.308 0 256 0 C 256 70.692 198.692 128 128 128 Z M 128 128 C 57.308 128 0 70.692 0 0 C 70.692 0 128 57.308 128 128 Z" />
        </svg>
        <span>Khondamir</span>
      </a>

      <div class="nav-right">
        <div class="links" role="navigation" aria-label="Main">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      </div>

      <button class="burger" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="drawer">
        <svg class="m" viewBox="0 0 24 24" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
        <svg class="x" viewBox="0 0 24 24" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
      </button>
    </nav>

    <div class="content">
      <div>
        <h1>Building products, and writing down what actually works</h1>
      </div>

      <div class="cards">
        {latest && (
          <a class="card stat-card" href={`/blog/${latest.data.transId}/`}>
            <div class="stat">{fmt(latest.data.pubDate)}</div>
            <p><b>{latest.data.title}</b></p>
            <p class="quote">{latest.data.excerpt}</p>
          </a>
        )}
        <div class="card quote-card">
          <p class="quote">“I did not conquer half the world by listening to men who had conquered nothing.”</p>
          <div class="who">
            <div>
              <b>Alexander the Great</b>
              <small>attributed</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="scrim" id="scrim" aria-hidden="true"></div>
<aside class="drawer" id="drawer" aria-label="Menu" inert>
  <a href="/blog/">Blog</a>
  <a href="/about/">About</a>
  {latest && (
    <a class="drawer__latest" href={`/blog/${latest.data.transId}/`}>
      <small>Latest · {fmt(latest.data.pubDate)}</small>
      <span>{latest.data.title}</span>
    </a>
  )}
  <span class="drawer__rule" aria-hidden="true"></span>
  {socials.map(([k, href]) => (
    <a class="drawer__social" href={href} target="_blank" rel="noopener noreferrer">{LABELS[k] ?? k}</a>
  ))}
  <a class="drawer__social" href={SOCIALS.email}>Email</a>
</aside>

<script>
  const burger = document.getElementById('burger');
  const drawer = document.getElementById('drawer');
  const scrim = document.getElementById('scrim');

  function setOpen(open: boolean) {
    if (!burger || !drawer) return;
    document.body.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    // inert убирает закрытую панель из Tab-порядка и от скринридеров:
    // без него фокус с клавиатуры уходил в невидимые ссылки за краем экрана.
    drawer.toggleAttribute('inert', !open);
    if (open) drawer.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
  }

  burger?.addEventListener('click', () => setOpen(!document.body.classList.contains('open')));
  scrim?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.body.classList.contains('open')) { setOpen(false); burger?.focus(); }
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', () => setOpen(false));
  // Возврат по «Назад» из bfcache: панель не должна остаться открытой.
  window.addEventListener('pageshow', (e) => { if (e.persisted) setOpen(false); });

  /* Автозапуск видео. iOS в режиме энергосбережения и некоторые Android-браузеры
     блокируют autoplay — тогда запускаем по первому касанию. При возврате на
     вкладку браузер ставит ролик на паузу — продолжаем. */
  const video = document.querySelector<HTMLVideoElement>('.hero video');
  const play = () => { if (video && video.paused) video.play()?.catch(() => {}); };
  if (video) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduce.matches) { video.removeAttribute('autoplay'); video.pause(); }
    else {
      play();
      document.addEventListener('pointerdown', play, { once: true, passive: true });
      document.addEventListener('visibilitychange', () => { if (!document.hidden) play(); });
    }
  }
</script>
