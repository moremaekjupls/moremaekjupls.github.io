---
import { useTranslations, localizeUrl, altLangUrl, stripBase, type Lang } from '../i18n/ui';
interface Props { lang: Lang; path: string; }
const { lang, path } = Astro.props;
const t = useTranslations(lang);
const L = (p: string) => localizeUrl(p, lang);

const homeHref = L('/');
const links = [
  { href: L('/blog'), label: t('nav.blog'), match: '/blog' },
  { href: L('/about'), label: t('nav.about'), match: '/about' },
];
// strip base + /en prefix for matching
const noBase = stripBase(path);
const rel = noBase.startsWith('/en') ? (noBase.slice(3) || '/') : noBase;
const isActive = (m: string) => rel === m || rel.startsWith(m + '/');
---
<header class="site-header">
  <div class="container nav">
    <a class="logo" href={homeHref} aria-label="Khondamir Begmatov — home">
      <svg class="mark" width="22" height="22" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M 128 128 C 128 198.692 70.692 256 0 256 C 0 185.308 57.308 128 128 128 Z M 128 128 C 198.692 128 256 185.308 256 256 C 185.308 256 128 198.692 128 128 Z M 128 128 C 128 57.308 185.308 0 256 0 C 256 70.692 198.692 128 128 128 Z M 128 128 C 57.308 128 0 70.692 0 0 C 70.692 0 128 57.308 128 128 Z" /></svg>
      <span>Khondamir<span style="color:var(--color-smoke)"> Begmatov</span></span>
    </a>

    <nav class="nav-right">
      <ul class="nav-links" id="navLinks">
        {links.map((l) => (
          <li><a href={l.href} aria-current={isActive(l.match) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="navLinks">{t('nav.menu')}</button>
    </nav>
  </div>
</header>

<script>
  /* Та же причина, что и в хиро: привязка к узлу требует перепривязки на
     каждой навигации, и любой сбой защиты даёт двойное срабатывание. */
  const W = window as any;
  if (!W.__headerDelegated) {
    W.__headerDelegated = true;
    document.addEventListener('click', (e) => {
      const el = e.target as HTMLElement | null;
      const links = document.getElementById('navLinks');
      if (!el || !el.closest || !links) return;
      if (el.closest('#menuBtn')) {
        const open = links.classList.toggle('open');
        document.getElementById('menuBtn')?.setAttribute('aria-expanded', String(open));
        return;
      }
      if (!el.closest('#navLinks')) links.classList.remove('open');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') document.getElementById('navLinks')?.classList.remove('open');
    });
  }
</script>
