---
import { useTranslations, localizeUrl, altLangUrl, stripBase, type Lang } from '../i18n/ui';
interface Props { lang: Lang; path: string; }
const { lang, path } = Astro.props;
const t = useTranslations(lang);
const L = (p: string) => localizeUrl(p, lang);

const homeHref = L('/');
const links = [
  { href: L('/blog'), label: t('nav.blog'), match: '/blog' },
  { href: L('/about'), label: t('nav.about'), match: '/about' },
];
// strip base + /en prefix for matching
const noBase = stripBase(path);
const rel = noBase.startsWith('/en') ? (noBase.slice(3) || '/') : noBase;
const isActive = (m: string) => rel === m || rel.startsWith(m + '/');
---
<header class="site-header">
  <div class="container nav">
    <a class="logo" href={homeHref} aria-label="Khondamir — home">
      <svg class="mark" width="22" height="22" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M 128 128 C 128 198.692 70.692 256 0 256 C 0 185.308 57.308 128 128 128 Z M 128 128 C 198.692 128 256 185.308 256 256 C 185.308 256 128 198.692 128 128 Z M 128 128 C 128 57.308 185.308 0 256 0 C 256 70.692 198.692 128 128 128 Z M 128 128 C 57.308 128 0 70.692 0 0 C 70.692 0 128 57.308 128 128 Z" /></svg>
      <span>Khondamir</span>
    </a>

    <nav class="nav-right" aria-label="Main">
      <ul class="nav-links" id="navLinks">
        {links.map((l) => (
          <li><a href={l.href} aria-current={isActive(l.match) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <button class="menu-btn" id="menuBtn" type="button" aria-expanded="false" aria-controls="navLinks" aria-label="Open menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><line class="l1" x1="4" y1="6" x2="20" y2="6" /><line class="l2" x1="4" y1="12" x2="20" y2="12" /><line class="l3" x1="4" y1="18" x2="20" y2="18" /></svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menuBtn');
  const links = document.getElementById('navLinks');
  const header = document.querySelector('.site-header');

  function setOpen(open: boolean) {
    if (!btn || !links) return;
    header?.classList.toggle('menu-open', open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;
    if (!header?.contains(el)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); }
  });
  // Меню открыто, окно расширили до десктопа — состояние не должно залипнуть.
  window.matchMedia('(min-width: 721px)').addEventListener('change', () => setOpen(false));
</script>
