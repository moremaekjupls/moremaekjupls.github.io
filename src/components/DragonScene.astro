---
/**
 * DragonScene.astro — the single-screen WebGL backdrop.
 *
 * Self-contained: styles, custom cursor and resize observer are all scoped to
 * this section. It draws nothing over the canvas on its own — whatever you put
 * inside the tag lands in the overlay layer.
 *
 *   <DragonScene>
 *     <nav>…</nav>
 *   </DragonScene>
 *
 * Props:
 *   height   CSS length for the section. Default "100svh".
 *   modelUrl optional .glb served from /public that replaces the procedural dragon.
 */
export interface Props {
  height?: string;
  modelUrl?: string;
  hint?: string;
}
const { height = "100svh", modelUrl = "", hint = "" } = Astro.props;
const uid = "dh-" + Math.random().toString(36).slice(2, 10);
---

<section class="dragon-scene" id={uid} style={`--dh-height:${height}`}>
  <canvas class="dh-canvas"></canvas>
  <div class="dh-vignette"></div>
  <div class="dh-grain"></div>

  <div class="dh-content"><slot /></div>

  {hint && <p class="dh-hint">{hint}</p>}

  <div class="dh-cursor"></div>
  <div class="dh-dot"></div>
  <div class="dh-boot"></div>
  <div class="dh-fallback"></div>
</section>

<style>
  .dragon-scene {
    position: relative;
    width: 100%;
    height: 100vh;
    height: var(--dh-height, 100svh);
    overflow: hidden;
    background: #000;
    isolation: isolate;
  }
  .dragon-scene.dh-hide-cursor,
  .dragon-scene.dh-hide-cursor * { cursor: none; }

  .dh-canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; touch-action: none; }

  .dh-vignette {
    position: absolute; inset: 0; pointer-events: none; z-index: 2;
    background: radial-gradient(78% 62% at 50% 52%, transparent 38%, rgba(0,0,0,.5) 76%, rgba(0,0,0,.95) 100%);
  }
  .dh-grain {
    position: absolute; inset: 0; pointer-events: none; z-index: 3;
    opacity: .09; mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3'/></filter><rect width='140' height='140' filter='url(%23n)' opacity='.6'/></svg>");
  }

  /* Revealed by CSS, not by script: if three.js fails to load or WebGL is
     unavailable, the navigation must still appear. The page has to survive
     a dead canvas. */
  .dh-content {
    position: absolute; inset: 0; z-index: 5;
    pointer-events: none;
    opacity: 0;
    animation: dh-reveal 1.4s ease .65s forwards;
  }
  .dh-content.in { opacity: 1; }
  @keyframes dh-reveal { to { opacity: 1; } }
  .dh-content :global(a),
  .dh-content :global(button) { pointer-events: auto; }

  .dh-cursor {
    position: fixed; top: 0; left: 0; z-index: 20; pointer-events: none;
    width: 46px; height: 46px; margin: -23px 0 0 -23px; border-radius: 50%;
    border: 1px solid rgba(255,255,255,.55); background: rgba(255,255,255,.03);
    transition: width .3s, height .3s, margin .3s, background .3s, border-color .3s;
    display: none;
  }
  .dh-cursor.on { display: block; }
  .dh-cursor.hot {
    width: 64px; height: 64px; margin: -32px 0 0 -32px;
    background: rgba(255,255,255,.10); border-color: rgba(255,255,255,.8);
  }
  .dh-cursor.grab {
    width: 30px; height: 30px; margin: -15px 0 0 -15px;
    background: rgba(240,184,85,.16); border-color: rgba(240,184,85,.9);
  }
  .dh-dot {
    position: fixed; top: 0; left: 0; z-index: 21; pointer-events: none;
    width: 4px; height: 4px; margin: -2px 0 0 -2px; border-radius: 50%;
    background: #fff; display: none;
  }
  .dh-dot.on { display: block; }

  /* The best thing on this page is invisible until you touch it. */
  .dh-hint {
    position: absolute; left: 50%; bottom: 74px; transform: translateX(-50%);
    z-index: 6; margin: 0; white-space: nowrap;
    font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase;
    color: rgba(240,184,85,.55);
    opacity: 0; animation: dh-hint-in 1.2s ease 2.4s forwards;
    transition: opacity .5s ease;
  }
  .dh-hint.gone { opacity: 0 !important; animation: none; }
  @keyframes dh-hint-in { to { opacity: 1; } }
  @media (max-width: 600px) { .dh-hint { bottom: 108px; font-size: 9.5px; } }

  .dh-boot {
    position: absolute; inset: 0; z-index: 9; background: #000;
    transition: opacity 1.1s ease;
    animation: dh-boot-out 1.1s ease .55s forwards;
  }
  .dh-boot.gone { opacity: 0; pointer-events: none; }
  @keyframes dh-boot-out { to { opacity: 0; visibility: hidden; } }

  .dh-fallback {
    position: absolute; inset: 0; z-index: 8; display: none;
    place-items: center; text-align: center; padding: 40px;
    color: var(--color-smoke, #9a9a9a); font-size: 14px; line-height: 1.7;
  }
</style>

<script is:inline src="/three.min.js"></script>
<script is:inline define:vars={{ uid, modelUrl }}>

(function () {
  "use strict";

  var root = document.getElementById(uid);
  if (!root) return;
  var canvas = root.querySelector(".dh-canvas");
  var boot = root.querySelector(".dh-boot");
  var ui = root.querySelector(".dh-content");

  // every dimension comes from the section, not the viewport
  var box = { w: root.clientWidth || 1, h: root.clientHeight || 1 };
  function measure() { box.w = root.clientWidth || 1; box.h = root.clientHeight || 1; }
  measure();

  var REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var MOBILE = window.matchMedia("(max-width: 900px)").matches;

  var renderer;
  try {
    renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: !MOBILE, alpha: true, powerPreference: "high-performance" });
  } catch (e) {
    var fb = root.querySelector(".dh-fallback");
    if (fb) { fb.textContent = "WebGL недоступен / WebGL unavailable"; fb.style.display = "grid"; }
    boot.classList.add("gone");
    return;
  }

  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, MOBILE ? 1.5 : 2));
  renderer.setSize(box.w, box.h);
  renderer.outputEncoding = THREE.sRGBEncoding;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.12;
  renderer.shadowMap.enabled = !MOBILE;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;

  var scene = new THREE.Scene();
  var camera = new THREE.PerspectiveCamera(34, box.w / box.h, 0.1, 300);

  var world = new THREE.Group();
  scene.add(world);

  var rnd = (function (s) { return function () { s = (s * 16807) % 2147483647; return s / 2147483647; }; })(4108);

  // ------------------------------------------------------------------
  // procedural stone maps — no image assets, no requests
  // ------------------------------------------------------------------
  function stoneTexture(baseHex, spread, veins) {
    var S = 512;
    var c = document.createElement("canvas");
    c.width = c.height = S;
    var g = c.getContext("2d");
    var base = new THREE.Color(baseHex);
    g.fillStyle = "rgb(" + ((base.r * 255) | 0) + "," + ((base.g * 255) | 0) + "," + ((base.b * 255) | 0) + ")";
    g.fillRect(0, 0, S, S);

    // grain
    for (var i = 0; i < 9000; i++) {
      var v = (rnd() - 0.5) * spread;
      var r = Math.max(0, Math.min(255, base.r * 255 + v * 255));
      var gg = Math.max(0, Math.min(255, base.g * 255 + v * 255));
      var b = Math.max(0, Math.min(255, base.b * 255 + v * 255));
      g.fillStyle = "rgba(" + (r | 0) + "," + (gg | 0) + "," + (b | 0) + ",.5)";
      var sz = 1 + rnd() * 3.5;
      g.fillRect(rnd() * S, rnd() * S, sz, sz);
    }
    // strata / veins
    g.lineWidth = 1;
    for (var k = 0; k < veins; k++) {
      g.strokeStyle = "rgba(" + ((base.r * 255 * (0.6 + rnd() * 0.7)) | 0) + "," +
                                ((base.g * 255 * (0.6 + rnd() * 0.7)) | 0) + "," +
                                ((base.b * 255 * (0.6 + rnd() * 0.7)) | 0) + ",.35)";
      g.beginPath();
      var y = rnd() * S, x = 0;
      g.moveTo(0, y);
      while (x < S) { x += 18 + rnd() * 40; y += (rnd() - 0.5) * 26; g.lineTo(x, y); }
      g.stroke();
    }
    var tex = new THREE.CanvasTexture(c);
    tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
    return tex;
  }

  var slabMap = stoneTexture(0x6a6660, 0.34, 90);
  slabMap.repeat.set(2, 1);
  var marbleMap = stoneTexture(0xd9d5cd, 0.16, 26);

  var slabMat = new THREE.MeshStandardMaterial({
    color: 0x8b8781, map: slabMap, bumpMap: slabMap, bumpScale: 0.035,
    roughness: 0.94, metalness: 0.03
  });
  var marbleMat = new THREE.MeshStandardMaterial({
    color: 0xe9e5dd, map: marbleMap, bumpMap: marbleMap, bumpScale: 0.008,
    roughness: 0.52, metalness: 0.0
  });

  // ------------------------------------------------------------------
  // rough-hewn helpers
  // ------------------------------------------------------------------
  function roughen(geo, amt, freq) {
    var pos = geo.attributes.position;
    for (var i = 0; i < pos.count; i++) {
      var x = pos.getX(i), y = pos.getY(i), z = pos.getZ(i);
      var n = Math.sin(x * freq * 1.7 + y * freq * 2.3) * 0.5 +
              Math.sin(y * freq * 3.1 - z * freq * 1.9) * 0.3 +
              Math.sin(z * freq * 2.7 + x * freq * 1.3) * 0.2;
      pos.setXYZ(i, x + n * amt, y + n * amt * 0.55, z + n * amt);
    }
    pos.needsUpdate = true;
    geo.computeVertexNormals();
    return geo;
  }

  // ------------------------------------------------------------------
  // the plinth: a cut slab on a broken column
  // ------------------------------------------------------------------
  var plinth = new THREE.Group();
  world.add(plinth);

  var slabGeo = roughen(new THREE.BoxGeometry(3.5, 0.66, 2.0, 12, 4, 8), 0.045, 1.9);
  var slab = new THREE.Mesh(slabGeo, slabMat);
  slab.position.y = -0.34;
  slab.castShadow = true; slab.receiveShadow = true;
  plinth.add(slab);

  // thin lip under the slab — reads as a cut edge
  var lipGeo = roughen(new THREE.BoxGeometry(3.1, 0.2, 1.72, 8, 2, 6), 0.03, 2.4);
  var lip = new THREE.Mesh(lipGeo, slabMat);
  lip.position.y = -0.76;
  lip.castShadow = true; lip.receiveShadow = true;
  plinth.add(lip);

  var colGeo = new THREE.BoxGeometry(2.05, 3.6, 1.5, 8, 12, 6);
  (function taper(geo) {
    var pos = geo.attributes.position;
    for (var i = 0; i < pos.count; i++) {
      var y = pos.getY(i);
      var t = (y + 1.8) / 3.6;           // 0 bottom → 1 top
      var s = 0.82 + t * 0.18;
      pos.setX(i, pos.getX(i) * s);
      pos.setZ(i, pos.getZ(i) * s);
    }
    pos.needsUpdate = true;
  })(colGeo);
  roughen(colGeo, 0.075, 1.5);
  var column = new THREE.Mesh(colGeo, slabMat);
  column.position.y = -2.55; // overlaps the lip by 0.15 — no hairline gap after roughening
  column.castShadow = true; column.receiveShadow = true;
  plinth.add(column);

  // ------------------------------------------------------------------
  // the figure on the plinth
  // ------------------------------------------------------------------
  var figure = new THREE.Group();
  figure.scale.setScalar(1.15);   // fills more of the frame
  figure.position.y = 0.012;   // sits on the slab
  plinth.add(figure);

  function part(mesh) { mesh.castShadow = true; mesh.receiveShadow = true; figure.add(mesh); return mesh; }

  // --- geometry helpers -------------------------------------------------
  // linear sample through a control array
  function at(arr, t) {
    var x = t * (arr.length - 1);
    var i0 = Math.floor(x), i1 = Math.min(arr.length - 1, i0 + 1), f = x - i0;
    return arr[i0] * (1 - f) + arr[i1] * f;
  }

  function buildGrid(position, rows, cols) {
    var index = [];
    for (var i = 1; i <= rows; i++) {
      for (var j = 1; j <= cols; j++) {
        var a = (cols + 1) * (i - 1) + (j - 1);
        var b = (cols + 1) * i + (j - 1);
        var c = (cols + 1) * i + j;
        var d = (cols + 1) * (i - 1) + j;
        index.push(a, b, d, b, c, d);
      }
    }
    var uv = [];
    for (var ui = 0; ui <= rows; ui++) {
      for (var uj = 0; uj <= cols; uj++) { uv.push(uj / cols, ui / rows); }
    }
    var g = new THREE.BufferGeometry();
    g.setAttribute("position", new THREE.Float32BufferAttribute(position, 3));
    g.setAttribute("uv", new THREE.Float32BufferAttribute(uv, 2));
    g.setIndex(index);
    g.computeVertexNormals();

    // Winding depends on which way the surface is swept — a shell built top-down
    // comes out inside-out. Measure against each ring's own centre and flip if needed.
    var nrm = g.attributes.normal, score = 0, i, j, k;
    for (i = 0; i <= rows; i++) {
      var base = i * (cols + 1), cx = 0, cy = 0, cz = 0;
      for (j = 0; j <= cols; j++) {
        cx += position[(base + j) * 3];
        cy += position[(base + j) * 3 + 1];
        cz += position[(base + j) * 3 + 2];
      }
      cx /= (cols + 1); cy /= (cols + 1); cz /= (cols + 1);
      for (j = 0; j <= cols; j += 2) {
        k = base + j;
        score += (position[k * 3] - cx) * nrm.getX(k) +
                 (position[k * 3 + 1] - cy) * nrm.getY(k) +
                 (position[k * 3 + 2] - cz) * nrm.getZ(k);
      }
    }
    if (score < 0) {
      for (var t = 0; t < index.length; t += 3) {
        var swap = index[t + 1]; index[t + 1] = index[t + 2]; index[t + 2] = swap;
      }
      g.setIndex(index);
      g.computeVertexNormals();
    }
    return g;
  }

  // swept tube of varying radius along a spline — every limb is one of these
  function limb(pts, radii, segs, radial, flat) {
    var v3 = pts.map(function (p) { return new THREE.Vector3(p[0], p[1], p[2]); });
    var curve = new THREE.CatmullRomCurve3(v3);
    var frames = curve.computeFrenetFrames(segs, false);
    var position = [], P = new THREE.Vector3();
    for (var i = 0; i <= segs; i++) {
      var t = i / segs;
      curve.getPointAt(t, P);
      var N = frames.normals[i], B = frames.binormals[i];
      var r = at(radii, t);
      for (var j = 0; j <= radial; j++) {
        var v = (j / radial) * Math.PI * 2;
        var cu = Math.cos(v) * r, cv = Math.sin(v) * r * flat;
        position.push(P.x + N.x * cu + B.x * cv, P.y + N.y * cu + B.y * cv, P.z + N.z * cu + B.z * cv);
      }
    }
    return buildGrid(position, segs, radial);
  }

  // stacked rings — torso and cloth, where cross-sections are ellipses, not circles
  function stack(steps, radial, fn) {
    var position = [];
    for (var i = 0; i <= steps; i++) {
      var s = fn(i / steps);
      var ts = s.thetaStart === undefined ? 0 : s.thetaStart;
      var tl = s.thetaLength === undefined ? Math.PI * 2 : s.thetaLength;
      for (var j = 0; j <= radial; j++) {
        var th = ts + (j / radial) * tl;
        var fold = s.fold ? s.fold * Math.sin(th * 6.0) : 0;
        position.push(
          (s.cx || 0) + Math.sin(th) * (s.rx + fold),
          s.y,
          (s.cz || 0) + Math.cos(th) * (s.rz + fold)
        );
      }
    }
    return buildGrid(position, steps, radial);
  }

  // --- scale pattern, drawn once into a canvas and used as a bump map -----
  function scaleTexture() {
    var S = 512, c = document.createElement("canvas");
    c.width = c.height = S;
    var g = c.getContext("2d");
    g.fillStyle = "#808080";
    g.fillRect(0, 0, S, S);
    var rows = 18, cols = 22, rw = S / cols, rh = S / rows;
    for (var r = 0; r < rows + 1; r++) {
      for (var i = 0; i < cols + 1; i++) {
        var x = (i + (r % 2 ? 0.5 : 0)) * rw, y = r * rh;
        g.lineWidth = 2.4;
        g.strokeStyle = "rgba(255,255,255,.42)";
        g.beginPath(); g.arc(x, y, rw * 0.60, 0, Math.PI); g.stroke();
        g.lineWidth = 1.6;
        g.strokeStyle = "rgba(0,0,0,.34)";
        g.beginPath(); g.arc(x, y + 2.5, rw * 0.60, 0.15, Math.PI - 0.15); g.stroke();
      }
    }
    var tex = new THREE.CanvasTexture(c);
    tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
    return tex;
  }
  var scaleMap = scaleTexture();
  scaleMap.repeat.set(9, 2);

  // Metal is almost entirely reflection, and there is nothing in this void to
  // reflect — without an environment the gold would render as a dark smear.
  // So: a hand-painted equirect sky, warm above, black below, with the shaft
  // of light and the amber rings baked in as the two things it can catch.
  function envTexture() {
    var W = 512, H = 256, c = document.createElement("canvas");
    c.width = W; c.height = H;
    var g = c.getContext("2d");

    var sky = g.createLinearGradient(0, 0, 0, H);
    sky.addColorStop(0.00, "#4a3417");
    sky.addColorStop(0.38, "#1a1208");
    sky.addColorStop(0.54, "#0b0b0d");
    sky.addColorStop(1.00, "#050506");
    g.fillStyle = sky;
    g.fillRect(0, 0, W, H);

    var beam = g.createRadialGradient(W * 0.42, H * 0.14, 3, W * 0.42, H * 0.14, H * 0.46);
    beam.addColorStop(0.00, "#fff1d6");
    beam.addColorStop(0.30, "#7d5a26");
    beam.addColorStop(1.00, "rgba(0,0,0,0)");
    g.fillStyle = beam;
    g.fillRect(0, 0, W, H);

    g.fillStyle = "rgba(224,167,94,.22)";
    g.fillRect(0, H * 0.46, W, H * 0.055);
    g.fillRect(0, H * 0.605, W, H * 0.035);

    var tex = new THREE.CanvasTexture(c);
    tex.encoding = THREE.sRGBEncoding;
    return tex;
  }

  // Prefilter it: a raw equirect map makes roughness behave wrongly on a PBR
  // material. Falls back to the plain texture if PMREM is unavailable.
  var envMap = (function () {
    var tex = envTexture();
    try {
      var pmrem = new THREE.PMREMGenerator(renderer);
      pmrem.compileEquirectangularShader();
      var rt = pmrem.fromEquirectangular(tex);
      pmrem.dispose();
      tex.dispose();
      return rt.texture;
    } catch (e) {
      tex.mapping = THREE.EquirectangularReflectionMapping;
      return tex;
    }
  })();

  var bodyMat = new THREE.MeshStandardMaterial({
    color: 0xf0b855, map: marbleMap, bumpMap: scaleMap, bumpScale: 0.026,
    roughness: 0.34, metalness: 0.92,
    envMap: envMap, envMapIntensity: 1.25
  });
  var hornMat = new THREE.MeshStandardMaterial({
    color: 0xc98f34, map: marbleMap, bumpMap: marbleMap, bumpScale: 0.012,
    roughness: 0.48, metalness: 0.95,
    envMap: envMap, envMapIntensity: 1.05
  });
  // toneMapped:false sends this straight to the framebuffer. Under ACES a hot
  // emissive desaturates toward white — which is why it was reading pink.
  // Green and blue are kept near zero so the clip lands on pure red.
  var eyeMat = new THREE.MeshStandardMaterial({
    color: 0x160100, emissive: 0xf80c04, emissiveIntensity: 1.75,
    roughness: 0.5, metalness: 0.0, toneMapped: false
  });

  function blob(r, sx, sy, sz, x, y, z, mat) {
    var m = new THREE.Mesh(new THREE.SphereGeometry(r, 16, 12), mat || bodyMat);
    m.scale.set(sx, sy, sz);
    m.position.set(x, y, z);
    return part(m);
  }

  // --- body: one unbroken coil, tail tip to neck --------------------------
  var bodyPts = [
    [ 0.30, 0.33, -0.60], [ 0.53, 0.19, -0.53], [ 0.66, 0.11, -0.20],
    [ 0.63, 0.10,  0.18], [ 0.41, 0.11,  0.50], [ 0.00, 0.13,  0.64],
    [-0.40, 0.15,  0.50], [-0.64, 0.17,  0.14], [-0.56, 0.23, -0.28],
    [-0.24, 0.31, -0.52], [ 0.20, 0.37, -0.48], [ 0.42, 0.40, -0.16],
    [ 0.44, 0.44,  0.16], [ 0.24, 0.49,  0.38], [-0.08, 0.54,  0.42],
    [-0.32, 0.61,  0.26], [-0.38, 0.73, -0.02], [-0.26, 0.90, -0.24],
    [ 0.00, 1.05, -0.28], [ 0.17, 1.20, -0.02], [ 0.12, 1.31,  0.24],
    [ 0.00, 1.36,  0.42]
  ];
  // thin at the tail, thickest through the middle coil, tapering into the neck
  var bodyR = [
    0.042, 0.072, 0.106, 0.140, 0.168, 0.192, 0.206, 0.212, 0.208, 0.198, 0.186,
    0.174, 0.164, 0.154, 0.144, 0.135, 0.126, 0.118, 0.111, 0.104, 0.099, 0.094
  ];
  part(new THREE.Mesh(limb(bodyPts, bodyR, 190, 16, 0.94), bodyMat));

  var bodyCurve = new THREE.CatmullRomCurve3(bodyPts.map(function (p) {
    return new THREE.Vector3(p[0], p[1], p[2]);
  }));

  // --- dorsal crest and mane: instanced, one draw call each ---------------
  function crest(from, to, count, w, h, thin, long, lift, mat) {
    var geo = new THREE.ConeGeometry(w, h, 4);
    geo.translate(0, h * 0.5, 0);
    var im = new THREE.InstancedMesh(geo, mat, count);
    im.castShadow = true;
    var d = new THREE.Object3D();
    var P = new THREE.Vector3(), T = new THREE.Vector3(), U = new THREE.Vector3();
    var X = new THREE.Vector3(), Z = new THREE.Vector3(), M = new THREE.Matrix4();
    for (var i = 0; i < count; i++) {
      var t = from + (to - from) * (i / (count - 1));
      bodyCurve.getPointAt(t, P);
      bodyCurve.getTangentAt(t, T);
      // world up, with the along-body component removed
      U.set(0, 1, 0).addScaledVector(T, -T.y);
      if (U.lengthSq() < 1e-6) U.set(0, 0, 1);
      U.normalize();
      X.crossVectors(U, T).normalize();
      Z.crossVectors(X, U).normalize();
      M.makeBasis(X, U, Z);
      d.position.copy(P).addScaledVector(U, at(bodyR, t) * lift);
      d.quaternion.setFromRotationMatrix(M);
      d.scale.set(thin, 1, long);
      d.updateMatrix();
      im.setMatrixAt(i, d.matrix);
    }
    figure.add(im);
    return im;
  }
