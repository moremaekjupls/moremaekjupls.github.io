    );
    camera.lookAt(0, 0.45, 0);

    plinth.position.y = Math.sin(t * 0.24) * 0.10;
    plinth.rotation.y = Math.sin(t * 0.07) * 0.05;

    for (var i = 0; i < haloes.length; i++) {
      haloes[i].group.rotation.z += haloes[i].spin * adt;
      haloes[i].mats[0].uniforms.uTime.value = t;
      haloes[i].mats[1].uniforms.uTime.value = t;
    }

    if (hasPointer) {
      raycaster.setFromCamera(mouseSmooth, camera);
      rayOrigin.copy(raycaster.ray.origin);
      rayDir.copy(raycaster.ray.direction);
    }

    for (var j = 0; j < COUNT; j++) {
      var p = D[j];
      p.a += p.speed * adt;
      var bx = Math.cos(p.a) * p.r;
      var bz = Math.sin(p.a) * p.r;
      var by = p.y + Math.sin(t * 0.42 + p.bobPhase) * p.bobAmp;

      p.target.set(0, 0, 0);
      if (hasPointer) {
        worldPos.set(bx, by, bz);
        away.copy(worldPos).sub(rayOrigin);
        var proj = away.dot(rayDir);
        if (proj > 0) {
          closest.copy(rayDir).multiplyScalar(proj).add(rayOrigin);
          away.copy(worldPos).sub(closest);
          var dist = away.length();
          if (dist < PUSH_RADIUS && dist > 0.0001) {
            var fo = 1 - dist / PUSH_RADIUS;
            away.divideScalar(dist).multiplyScalar(fo * fo * PUSH_FORCE);
            p.target.copy(away);
          }
        }
      }
      // flees fast, drifts back slowly
      var ease = p.target.lengthSq() > p.off.lengthSq() ? 0.20 : 0.028;
      p.off.lerp(p.target, ease);

      dummy.position.set(bx + p.off.x, by + p.off.y, bz + p.off.z);
      p.rot.x += p.spin.x * adt; p.rot.y += p.spin.y * adt; p.rot.z += p.spin.z * adt;
      dummy.rotation.copy(p.rot);
      dummy.scale.setScalar(p.scale);
      dummy.updateMatrix();
      debris.setMatrixAt(j, dummy.matrix);
    }
    debris.instanceMatrix.needsUpdate = true;

    // --- fire ---
    if (fireCd > 0) fireCd -= dt;
    var jawTarget = fireCd > 0.6 ? 1 : 0;
    jawOpen += (jawTarget - jawOpen) * Math.min(1, dt * 14);
    if (jaw) jaw.rotation.x = jawOpen * 0.40;

    for (var fk = 0; fk < FIRE_N; fk++) {
      var fp = FP[fk];
      if (fp.life <= 0) continue;
      fp.life -= dt;
      if (fp.life <= 0) { firePos[fk * 3 + 1] = -999; fireCol[fk * 3] = fireCol[fk * 3 + 1] = fireCol[fk * 3 + 2] = 0; continue; }
      fp.vel.multiplyScalar(1 - Math.min(0.9, 2.0 * dt));
      fp.vel.y += 1.6 * dt;                       // flame rises as it slows
      fp.pos.addScaledVector(fp.vel, dt);
      firePos[fk * 3] = fp.pos.x; firePos[fk * 3 + 1] = fp.pos.y; firePos[fk * 3 + 2] = fp.pos.z;
      var kk = fp.life / fp.max;                  // 1 → 0
      fireCol[fk * 3]     = Math.min(1, kk * 1.7);          // white-hot core
      fireCol[fk * 3 + 1] = Math.min(1, Math.pow(kk, 2.1) * 1.3);
      fireCol[fk * 3 + 2] = Math.pow(kk, 5.0) * 0.9;        // blue only at the very start
    }
    fireGeo.attributes.position.needsUpdate = true;
    fireGeo.attributes.color.needsUpdate = true;

    if (fireCd > 0) {
      mouthW.copy(mouthLocal); headGroup.localToWorld(mouthW);
      fireLight.position.copy(mouthW);
    }
    fireLight.intensity = Math.max(0, fireCd - 0.25) * 6.0;

    starField.rotation.y += adt * 0.004;
    shaftMat.uniforms.uTime.value = t;

    renderer.render(scene, camera);
  }

  frame();

  setTimeout(function () { if (boot) boot.classList.add("gone"); if (ui) ui.classList.add("in"); }, 650);
})();

</script>
