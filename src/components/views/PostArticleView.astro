---
import { useTranslations, localizeUrl, readingMinutes, readingLabel, type Lang } from '../../i18n/ui';
import type { CollectionEntry } from 'astro:content';
interface Props { lang: Lang; entry: CollectionEntry<'blog'>; next?: CollectionEntry<'blog'>; }
const { lang, entry, next } = Astro.props;
const t = useTranslations(lang);
const { Content } = await entry.render();
const fmt = new Intl.DateTimeFormat(lang === 'ru' ? 'ru-RU' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(entry.data.pubDate);
---
<div class="read-progress" id="readProgress" aria-hidden="true"></div>
<article class="section">
  <div class="container">
    <div class="article">
      <a class="link-arrow" href={localizeUrl('/blog', lang)}>{t('cta.backToBlog')}</a>
      <p class="article-meta" style="margin-top:20px;">{fmt} · {readingLabel(lang, readingMinutes(entry.body))}</p>
      <h1 style={`margin-bottom:32px;view-transition-name:post-${entry.data.transId}`}>{entry.data.title}</h1>
      <div class="prose">
        <Content />
      </div>
      <div class="article-end">
        {next && (
          <a class="next-post card" href={localizeUrl(`/blog/${next.data.transId}`, lang)}>
            <span class="next-post__label">Read next</span>
            <span class="next-post__title" style={`view-transition-name:post-${next.data.transId}`}>{next.data.title}</span>
            <span class="next-post__excerpt">{next.data.excerpt}</span>
          </a>
        )}
        <a class="link-arrow" href={localizeUrl('/blog', lang)}>{t('cta.allPosts')} →</a>
      </div>
    </div>
  </div>
</article>

<script>
  const bar = document.getElementById('readProgress');
  const art = document.querySelector<HTMLElement>('.article');
  if (bar && art) {
    let queued = false;
    const update = () => {
      queued = false;
      const total = Math.max(art.offsetHeight - window.innerHeight, 1);
      const scrolled = Math.min(Math.max(-art.getBoundingClientRect().top, 0), total);
      bar.style.transform = `scaleX(${scrolled / total})`;
    };
    // Не чаще одного пересчёта за кадр, сколько бы scroll-событий ни пришло.
    const schedule = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    update();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
  }
</script>
