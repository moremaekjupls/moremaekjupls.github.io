---
import { getPosts, postUrl, formatDate, readingLabel } from '../../lib/site';
const posts = await getPosts();
---
<section class="page-intro">
  <div class="container">
    <span class="eyebrow">Blog</span>
    <h1 class="display">AI through<br />a builder’s eyes.</h1>
    <p class="body body--muted" style="margin-top:24px;">News and analysis about artificial intelligence — from the point of view of someone shipping small products solo.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    {posts.length === 0 ? (
      <p class="muted">No posts yet.</p>
    ) : (
      <div class="post-list">
        {posts.map((p, i) => (
          <a class={`post-row${i === 0 ? ' post-row--lead' : ''}`} href={postUrl(p)}>
            <div class="post-row-date">{formatDate(p.data.pubDate, 'short')}<span class="post-row-read">{readingLabel(p.body)}</span></div>
            <div>
              <h2 class="post-row-title" style={`view-transition-name:post-${p.data.transId}`}>{p.data.title}</h2>
              <p class="post-row-excerpt">{p.data.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</section>
