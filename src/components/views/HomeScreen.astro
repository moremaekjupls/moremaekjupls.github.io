---
// The whole home page: one screen, the dragon behind, navigation on top.
import Hero from '../Hero.astro';
import { useTranslations, localizeUrl, altLangUrl, type Lang } from '../../i18n/ui';
import { SOCIALS } from '../../consts';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = (p: string) => localizeUrl(p, lang);
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const links = [
  { href: L('/blog'), label: t('nav.blog') },
  { href: L('/about'), label: t('nav.about') },
];

const socials = [
  { key: 'github', label: 'GitHub', href: SOCIALS.github, path: 'M12 1.5a10.5 10.5 0 0 0-3.32 20.46c.52.1.71-.23.71-.5v-1.9c-2.9.63-3.52-1.24-3.52-1.24-.48-1.2-1.16-1.52-1.16-1.52-.95-.65.07-.64.07-.64 1.05.08 1.6 1.08 1.6 1.08.94 1.6 2.46 1.14 3.06.87.1-.68.37-1.14.66-1.4-2.32-.26-4.76-1.16-4.76-5.16 0-1.14.41-2.07 1.07-2.8-.1-.26-.46-1.32.1-2.74 0 0 .88-.28 2.88 1.07a9.9 9.9 0 0 1 5.24 0c2-1.35 2.87-1.07 2.87-1.07.57 1.42.21 2.48.1 2.74.67.73 1.07 1.66 1.07 2.8 0 4.01-2.45 4.9-4.78 5.16.38.32.71.95.71 1.92v2.85c0 .28.19.61.72.5A10.5 10.5 0 0 0 12 1.5Z' },
  { key: 'x', label: 'X', href: SOCIALS.x, path: 'M17.5 3h2.9l-6.35 7.26L21.5 21h-5.86l-4.6-6.02L5.8 21H2.9l6.8-7.77L2.5 3h6l4.16 5.5L17.5 3Zm-1.02 16.2h1.6L7.6 4.72H5.88l10.6 14.48Z' },
  { key: 'linkedin', label: 'LinkedIn', href: SOCIALS.linkedin, path: 'M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5ZM3 9.25h3.96V21H3V9.25ZM9.25 9.25H13v1.6h.05c.52-.94 1.8-1.94 3.7-1.94 3.96 0 4.7 2.5 4.7 5.75V21h-3.96v-5.2c0-1.24-.02-2.84-1.73-2.84-1.74 0-2 1.35-2 2.75V21H9.25V9.25Z' },
];

const ruUrl = altLangUrl(path, 'ru');
const enUrl = altLangUrl(path, 'en');
---
<div class="screen-root">
  <Hero lang={lang} />

  <a href="#screen-nav" class="skip-link">{lang === 'ru' ? 'К навигации' : 'Skip to navigation'}</a>

  <nav class="screen-nav" id="screen-nav" aria-label={lang === 'ru' ? 'Основная навигация' : 'Main navigation'}>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>

  <div class="screen-lang" role="group" aria-label="Language">
    <a href={ruUrl} aria-current={lang === 'ru' ? 'true' : 'false'} hreflang="ru">RU</a>
    <a href={enUrl} aria-current={lang === 'en' ? 'true' : 'false'} hreflang="en">EN</a>
  </div>

  <button
    class="screen-music"
    type="button"
    data-music-toggle
    data-label-off={lang === 'ru' ? 'Включить музыку' : 'Play ambient music'}
    data-label-on={lang === 'ru' ? 'Поставить музыку на паузу' : 'Pause ambient music'}
    aria-pressed="false"
    aria-label={lang === 'ru' ? 'Включить музыку' : 'Play ambient music'}
  >
    <svg class="screen-music__icon screen-music__icon--play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10-6.5-10-6.5Z" fill="currentColor" /></svg>
    <svg class="screen-music__icon screen-music__icon--pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3v14H7V5Zm7 0h3v14h-3V5Z" fill="currentColor" /></svg>
    <span data-music-text>{lang === 'ru' ? 'Музыка' : 'Music'}</span>
  </button>
  <audio data-site-music preload="metadata" loop src="/fairy-library-ambient.mp3"></audio>

  <ul class="screen-socials">
    {socials.map((s) => (
      <li>
        <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  const musicButton = document.querySelector<HTMLButtonElement>('[data-music-toggle]');
  const music = document.querySelector<HTMLAudioElement>('[data-site-music]');
  const musicText = musicButton?.querySelector<HTMLElement>('[data-music-text]');
  if (musicButton && music) {
    music.volume = 0.32;
    musicButton.addEventListener('click', async () => {
      if (music.paused) {
        try {
          await music.play();
          musicButton.classList.add('is-playing');
          musicButton.setAttribute('aria-pressed', 'true');
          musicButton.setAttribute('aria-label', musicButton.dataset.labelOn || 'Pause ambient music');
          if (musicText) musicText.textContent = '♪';
        } catch {
          musicButton.setAttribute('aria-label', musicButton.dataset.labelOff || 'Play ambient music');
        }
      } else {
        music.pause();
        musicButton.classList.remove('is-playing');
        musicButton.setAttribute('aria-pressed', 'false');
        musicButton.setAttribute('aria-label', musicButton.dataset.labelOff || 'Play ambient music');
        if (musicText) musicText.textContent = 'Музыка';
      }
    });
  }
</script>
