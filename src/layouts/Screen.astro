---
// Screen.astro — layout for the single-screen home. No header, no footer,
// no scrolling: the page is exactly one viewport and the scene fills it.
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { ViewTransitions } from 'astro:transitions';
import type { Lang } from '../i18n/ui';
import { SITE } from '../consts';

interface Props { lang: Lang; title?: string; description?: string; }
const { lang, title = '', description = '' } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ? `${SITE.name} — ${title}` : SITE.name}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:title" content={SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE.domain + path} />
    <meta property="og:image" content={SITE.domain + "/og.png"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={SITE.domain + "/og.png"} />
    <link rel="alternate" type="application/rss+xml" title="Khondamir Begmatov — Blog" href={lang === 'en' ? '/en/rss.xml' : '/rss.xml'} />
    <link rel="icon" href={import.meta.env.BASE_URL.replace(/\/$/, '') + '/favicon.svg'} type="image/svg+xml" />
    <ViewTransitions />
    <Analytics />
  </head>
  <body class="is-screen">
    <slot />
    <audio data-site-music transition:persist preload="metadata" loop src="/fairy-library-ambient.mp3"></audio>

    <script>
      // The audio element is persisted across view transitions, so the toggle has
      // to re-bind on every navigation and read state from the element, not from
      // its own memory.
      function bindMusic() {
        const audio = document.querySelector<HTMLAudioElement>('[data-site-music]');
        if (!audio) return;
        audio.volume = 0.32;
        for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-music-toggle]')) {
          const sync = () => {
            const on = !audio.paused;
            btn.classList.toggle('is-playing', on);
            btn.setAttribute('aria-pressed', String(on));
            btn.setAttribute('aria-label', on ? 'Pause ambient music' : 'Play ambient music');
          };
          sync();
          if ((btn as any)._bound) continue;
          (btn as any)._bound = true;
          btn.addEventListener('click', async () => {
            if (audio.paused) {
              try { await audio.play(); } catch { /* браузер отказал в автозапуске */ }
            } else {
              audio.pause();
            }
            sync();
          });
          audio.addEventListener('play', sync);
          audio.addEventListener('pause', sync);
        }
      }
      bindMusic();
      document.addEventListener('astro:page-load', bindMusic);
    </script>
  </body>
</html>
