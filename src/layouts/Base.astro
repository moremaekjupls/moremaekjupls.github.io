---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import { withSlash } from '../lib/site';

interface Props { title: string; description?: string; }
const { title, description = '' } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = SITE.domain + withSlash(path);
const fullTitle = title ? `${title} — ${SITE.name}` : SITE.name;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE.domain + "/og.jpg"} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={SITE.domain + "/og.jpg"} />
    <link rel="alternate" type="application/rss+xml" title="Khondamir — Blog" href="/rss.xml" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <!-- iOS игнорирует SVG-иконки и без этого берёт случайную картинку со страницы -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Установленное на iPhone приложение: без адресной строки, статус-бар
         поверх страницы (отступы от выреза уже заложены через safe-area). -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Khondamir" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="preload" href="/fonts/geist-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="scroll-sentinel" aria-hidden="true"></div>
    <div class="page-bg" aria-hidden="true"></div>
    <div class="page-scrim" aria-hidden="true"></div>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // iOS Safari не применяет :active при касании, пока на странице нет ни
      // одного обработчика touchstart. Пустого пассивного достаточно — без него
      // все кнопки на iPhone нажимаются молча.
      document.addEventListener('touchstart', () => {}, { passive: true });

      // Service worker — только в продакшен-сборке, чтобы кэш не мешал pnpm dev.
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }

      // Шапка становится «стеклом», только когда под неё уезжает контент.
      const header = document.querySelector('.site-header');
      const sentinel = document.querySelector('.scroll-sentinel');
      if (header && sentinel && 'IntersectionObserver' in window) {
        new IntersectionObserver(([e]) => header.classList.toggle('is-scrolled', !e.isIntersecting))
          .observe(sentinel);
      }

      /* Мягкое появление блоков при прокрутке. Всё, что уже на экране при
         загрузке, показывается сразу — иначе первый экран мигает пустотой. */
      const sel = '.post-row, .article .prose, .article-end, .history-month';
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries, obs) => {
          // Блоки, въехавшие в экран одним кадром, появляются каскадом по 60ms.
          let i = 0;
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            (e.target as HTMLElement).style.animationDelay = `${Math.min(i++ * 60, 240)}ms`;
            e.target.classList.add('is-visible');
            obs.unobserve(e.target);
          }
        }, { threshold: 0.08, rootMargin: '0px 0px -6% 0px' });
        for (const el of document.querySelectorAll(sel)) {
          if (el.getBoundingClientRect().top < window.innerHeight * 0.92) continue;
          el.classList.add('reveal-init');
          io.observe(el);
        }
      }
    </script>
  </body>
</html>
