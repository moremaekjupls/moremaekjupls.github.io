---
import Base from '../layouts/Base.astro';
import Particles from '../components/Particles.astro';
---
<Base lang="en" title="Page not found" description="This page does not exist.">
  <section class="section notfound">
    <div class="notfound__bg" aria-hidden="true"><Particles variant="sphere" density={1} /></div>
    <div class="container notfound__inner">
      <span class="eyebrow">404</span>
      <h1 class="display">Lost<br />in space.</h1>
      <p class="body body--muted">This page drifted off into the void. The rest of the site is still here.</p>
      <div class="notfound__actions">
        <a class="btn btn-primary" href="/">Back home</a>
        <a class="btn btn-ghost" href="/blog">Read the blog</a>
      </div>
    </div>
  </section>
</Base>
