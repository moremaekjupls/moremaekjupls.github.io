---
/**
 * 404.astro — самостоятельная страница ошибки.
 *
 * Намеренно не использует общий макет: у него шапка, подвал и фоновые слои,
 * которые легли бы поверх видео. Здесь нужен чистый холст, поэтому документ
 * собран целиком, а стили помечены is:inline, чтобы Astro их не трогал.
 * Классы с префиксом nf- — защита от пересечения с глобальной таблицей.
 */
import { SITE } from '../consts';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>404 — {SITE.name}</title>
    <meta name="description" content="This page does not exist." />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preload" href="/fonts/geist-variable.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
  @font-face{font-family:"Geist";font-style:normal;font-weight:100 900;font-display:swap;
    src:url("/fonts/geist-variable.woff2") format("woff2-variations"),url("/fonts/geist-variable.woff2") format("woff2");}

  *{margin:0;padding:0;box-sizing:border-box}
  html,body{background:#000;color:#fff;overflow-x:hidden;
    font-family:"Geist",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    -webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none;-webkit-tap-highlight-color:transparent}
  :focus-visible{outline:2px solid rgba(255,255,255,.9);outline-offset:3px;border-radius:10px}

  /* Flex column instead of absolute centring: on a short landscape phone the
     old layout pushed the numerals over the logo. Now the page just scrolls. */
  .nf-page{position:relative;min-height:100svh;min-height:100dvh;width:100%;display:flex;flex-direction:column;
    align-items:center;padding:calc(32px + env(safe-area-inset-top,0px)) 20px calc(40px + env(safe-area-inset-bottom,0px))}

  .nf-bg{position:fixed;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
  /* The sky behind the copy is the brightest part of the shot. */
  .nf-shade{position:fixed;inset:0;z-index:1;pointer-events:none;
    background:radial-gradient(ellipse 70% 55% at 50% 50%,rgba(0,0,0,.45),rgba(0,0,0,.15) 70%,transparent),
               linear-gradient(180deg,rgba(0,0,0,.35),transparent 30%,transparent 70%,rgba(0,0,0,.4))}

  .nf-brand{position:relative;z-index:2;display:flex;align-items:center;gap:10px;border-radius:10px;
    font-weight:600;font-size:1.125rem;text-shadow:0 1px 14px rgba(0,0,0,.45)}
  .nf-brand svg{width:24px;height:24px;fill:#fff;filter:drop-shadow(0 1px 8px rgba(0,0,0,.45))}

  .nf-content{position:relative;z-index:2;margin-block:auto;padding-block:32px;width:min(100%,520px);
    display:flex;flex-direction:column;align-items:center;text-align:center;gap:28px}
  .nf-four{font-weight:600;font-size:clamp(128px,34vw,280px);line-height:.9;letter-spacing:-.07em;
    padding-right:.07em;
    background-image:linear-gradient(247deg,#fff 2.5%,rgba(255,255,255,.55) 94%);
    -webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;
    filter:drop-shadow(0 2px 30px rgba(0,0,0,.35))}
  .nf-rule{width:min(100%,425px);height:1px;background:rgba(255,255,255,.7)}
  .nf-message{font-weight:500;font-size:clamp(17px,4.4vw,22px);line-height:1.35;letter-spacing:-.02em;
    max-width:26ch;text-wrap:balance;text-shadow:0 1px 14px rgba(0,0,0,.5)}

  .nf-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:4px}
  .nf-btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:12px 22px;
    border-radius:999px;font-size:.9375rem;font-weight:500;
    background:rgba(255,255,255,.14);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
    transition:background-color .2s,transform .12s cubic-bezier(.2,.8,.3,1)}
  .nf-btn--primary{background:#fff;color:#000}
  .nf-btn:active{transform:scale(.965)}
  @media (hover:hover) and (pointer:fine){
    .nf-btn:hover{background:rgba(255,255,255,.22)}
    .nf-btn--primary:hover{background:rgba(255,255,255,.88)}
  }
  @media (prefers-reduced-motion:reduce){.nf-btn{transition:none}}
    </style>
  </head>
  <body>
    <main class="nf-page">
      <video class="nf-bg" autoplay loop muted playsinline preload="auto" poster="/404-frame.jpg" aria-hidden="true">
        <source src="/404.mp4" type="video/mp4" />
      </video>
      <div class="nf-shade" aria-hidden="true"></div>

      <a class="nf-brand" href="/">
        <svg viewBox="0 0 256 256" aria-hidden="true">
          <path d="M 128 128 C 128 198.692 70.692 256 0 256 C 0 185.308 57.308 128 128 128 Z M 128 128 C 198.692 128 256 185.308 256 256 C 185.308 256 128 198.692 128 128 Z M 128 128 C 128 57.308 185.308 0 256 0 C 256 70.692 198.692 128 128 128 Z M 128 128 C 57.308 128 0 70.692 0 0 C 70.692 0 128 57.308 128 128 Z" />
        </svg>
        <span>{SITE.name}</span>
      </a>

      <div class="nf-content">
        <h1 class="nf-four" aria-label="404: page not found">404</h1>
        <div class="nf-rule" aria-hidden="true"></div>
        <p class="nf-message">The path may be broken, but the journey isn't. Let's get you back.</p>
        <div class="nf-actions">
          <a class="nf-btn nf-btn--primary" href="/">Back to home</a>
          <a class="nf-btn" href="/blog/">Read the blog</a>
        </div>
      </div>
    </main>
    <script is:inline>
      // Уменьшенное движение — статичный кадр вместо ролика.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var v = document.querySelector('.nf-bg'); if (v) { v.removeAttribute('autoplay'); v.pause(); }
      }
    </script>
  </body>
</html>
