---
import Base from '../../layouts/Base.astro';
import PostArticleView from '../../components/views/PostArticleView.astro';
import { getPosts } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  // «Следующая» — та, что старше по дате; для самой старой замыкаем на свежую,
  // чтобы не упираться в тупик.
  return posts.map((entry, i) => ({
    params: { slug: entry.data.transId },
    props: { entry, next: posts[i + 1] ?? (posts.length > 1 ? posts[0] : undefined) },
  }));
}
const { entry, next } = Astro.props;
---
<Base title={entry.data.title} description={entry.data.excerpt}>
  <PostArticleView entry={entry} next={next} />
</Base>
